# Output of the opt-in synthetic demonstration stage (evaluation/score.py). It is
# a fabricated illustration, not a measurement, and must never be mistaken for
# leaderboard/results.csv, which analyze.py writes from real scanner runs.
leaderboard/results.synthetic.csv

# Submission bundle produced by `make -C paper dist`. Pure derived output: it
# duplicates the manuscript, refs.bib, the generated tables and the figures, so
# tracking it doubles every paper change in the history. The manuscript's own
# PDF is tracked deliberately, so that a reader of the repository can see the
# typeset paper without a LaTeX toolchain, and is not covered here.
paper/dist/
paper/*-submission.tar.gz

# Springer's svjour3 macro package, "(c) Springer" with no redistribution grant,
# so it is not relicensed under this repository's MIT licence. Fetch it into
# paper/ as paper/README.md describes; `make dist` copies it into the bundle.
paper/svjour3.cls
paper/svglov3.clo
paper/spbasic.bst

# LaTeX intermediates. Regenerated by every build and removed by `make -C paper
# clean`; the .bbl the submission needs is produced inside paper/dist/ by
# `make dist`, so there is nothing here a submitter would have to keep.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
